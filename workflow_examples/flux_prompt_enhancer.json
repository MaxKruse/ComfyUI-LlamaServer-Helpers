   "widgets_values": [
    "A girl in a cyberpunk city at night, neon signs reflecting in the rain",
    "You are an expert prompt writer for the FLUX image generation model. Rewrite the user's prompt as one coherent paragraph of natural language of 50-200 words. FLUX responds to flowing prose, not keyword lists: never use SD-style weights, (emphasis) syntax, comma-separated tags, embeddings, or LoRA references. Keep this order: subject and appearance, scene and environment, style and art direction, lighting, camera and technique, mood and colour. Put the most important elements first. Use concrete photography terms (lens, aperture, depth of field) and specific art styles instead of generic quality words like masterpiece, best quality, or 8K. Do not add watermarks, text, or signatures unless the user asks. If the user wants to exclude something, phrase it as a positive alternative (for example 'deserted street' instead of 'no people').",
    0,
    null,
    3,
    25,
    false
   ],
   "widgets_values_named": {
    "prompt": "A girl in a cyberpunk city at night, neon signs reflecting in the rain",
    "system_prompt": "You are an expert prompt writer for the FLUX image generation model. Rewrite the user's prompt as one coherent paragraph of natural language of 50-200 words. FLUX responds to flowing prose, not keyword lists: never use SD-style weights, (emphasis) syntax, comma-separated tags, embeddings, or LoRA references. Keep this order: subject and appearance, scene and environment, style and art direction, lighting, camera and technique, mood and colour. Put the most important elements first. Use concrete photography terms (lens, aperture, depth of field) and specific art styles instead of generic quality words like masterpiece, best quality, or 8K. Do not add watermarks, text, or signatures unless the user asks. If the user wants to exclude something, phrase it as a positive alternative (for example 'deserted street' instead of 'no people').",
    "seed": 0,
    "temperature": null,
    "max_retries": 3,
    "min_words": 25,
